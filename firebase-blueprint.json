{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered DermaSnap patient profile and contact info",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User identifier matching auth.uid"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 100
        },
        "whatsappNumber": {
          "type": "string",
          "description": "WhatsApp phone number with country code",
          "maxLength": 25
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "name", "whatsappNumber", "createdAt"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Skin health triage consultation record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Consultation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "patientName": {
          "type": "string",
          "description": "Name of the patient",
          "maxLength": 100
        },
        "whatsappNumber": {
          "type": "string",
          "description": "WhatsApp contact number",
          "maxLength": 25
        },
        "text": {
          "type": "string",
          "description": "Reported symptoms description",
          "maxLength": 5000
        },
        "summary": {
          "type": "string",
          "description": "Clinical care and prescription report",
          "maxLength": 5000
        },
        "urgency": {
          "type": "string",
          "description": "Urgency rating (Routine, Soon, Urgent)",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Consultation timestamp"
        }
      },
      "required": ["id", "userId", "patientName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document indexed by auth UID"
    },
    "/users/{userId}/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Subcollection of consultations belonging to the user"
    }
  }
}
